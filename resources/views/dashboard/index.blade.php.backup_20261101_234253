<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('show');
        document.getElementById('sidebarOverlay').classList.toggle('show');
    }

    const trenCanvas = document.getElementById('grafikTren');

    if (trenCanvas) {
        new Chart(trenCanvas, {
            type: 'bar',
            data: {
                labels: @json($grafikTrenLabel),
                datasets: [{
                    label: 'Jumlah Laporan',
                    data: @json($grafikTrenData),
                    backgroundColor: '#2c8058',
                    borderRadius: 5,
                    maxBarThickness: 35
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0 },
                        grid: { color: '#edf1ee' }
                    },
                    x: { grid: { display: false } }
                }
            }
        });
    }

    const statusCanvas = document.getElementById('grafikStatus');

    if (statusCanvas) {
        new Chart(statusCanvas, {
            type: 'doughnut',
            data: {
                labels: ['Menunggu', 'Diproses', 'Selesai'],
                datasets: [{
                    data: @json($grafikStatus),
                    backgroundColor: ['#b7d9c3', '#2c8058', '#176b43'],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            boxWidth: 7,
                            padding: 15,
                            font: { size: 11 }
                        }
                    }
                }
            }
        });
    }
</script>
