<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SI Pantau TPS | DLH Kabupaten Indramayu</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

   <style>
:root {
    --forest: #123d2b;
    --forest-2: #18583b;
    --green: #218653;
    --lime: #c7ef65;
    --mint: #eaf5e9;
    --paper: #f7f9f4;
    --white: #ffffff;
    --ink: #183528;
    --muted: #738078;
    --line: #e5ece5;
    --shadow: 0 16px 40px rgba(18,61,43,.09);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 85px;
}

body {
    font-family: "Inter", "Segoe UI", Arial, sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.65;
    font-size: 14px;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

button, input {
    font: inherit;
}

.container {
    width: min(90%, 1200px);
    margin: auto;
}

/* NAVBAR */
.navbar {
    position: sticky;
    top: 0;
    z-index: 999;
    background: rgba(255,255,255,.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid rgba(18,61,43,.08);
    transition: box-shadow .3s ease, background .3s ease;
}

.navbar-content {
    min-height: 72px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
}

.brand {
    display: flex;
    align-items: center;
    gap: 11px;
    flex-shrink: 0;
}

.brand-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    color: white;
    font-size: 21px;
    background: linear-gradient(145deg, #2ba66a, #124b32);
    box-shadow: 0 7px 17px rgba(33,134,83,.22);
    transition: transform .3s ease;
}

.brand:hover .brand-icon {
    transform: rotate(-9deg) scale(1.06);
}

.brand h2 {
    color: var(--forest);
    font-size: 16px;
    font-weight: 850;
    line-height: 1.3;
    letter-spacing: -.4px;
}

.brand p {
    color: var(--muted);
    font-size: 10px;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 31px;
}

.nav-links a {
    position: relative;
    color: #52645a;
    font-size: 13px;
    font-weight: 600;
    transition: color .25s ease;
}

.nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 0;
    height: 2px;
    border-radius: 5px;
    background: var(--green);
    transition: width .3s ease;
}

.nav-links a:hover {
    color: var(--green);
}

.nav-links a:hover::after {
    width: 100%;
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 9px;
}

/* BUTTON */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 17px;
    border: 1px solid transparent;
    border-radius: 9px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: transform .25s ease, box-shadow .25s ease,
                background .25s ease, color .25s ease;
}

.btn:hover {
    transform: translateY(-3px);
}

.btn-primary {
    color: white;
    background: linear-gradient(135deg, #25945b, #176b43);
    box-shadow: 0 7px 18px rgba(33,134,83,.2);
}

.btn-primary:hover {
    background: linear-gradient(135deg, #2da96a, #155b39);
    box-shadow: 0 11px 23px rgba(33,134,83,.28);
}

.btn-outline {
    color: var(--forest-2);
    border-color: #b8d2bf;
    background: white;
}

.btn-outline:hover {
    color: var(--green);
    border-color: var(--green);
    background: #f0f8f0;
}

.btn-white {
    color: var(--forest);
    background: white;
    white-space: nowrap;
}

.btn-white:hover {
    background: var(--lime);
}

/* HERO */
.hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 75px 0 88px;
    background:
        radial-gradient(ellipse at 85% 15%, rgba(199,239,101,.22), transparent 29%),
        radial-gradient(ellipse at 0% 100%, rgba(33,134,83,.10), transparent 35%),
        linear-gradient(120deg, #f0f7ed 0%, #f8faf5 52%, #e8f3e8 100%);
}

.hero::before,
.hero::after {
    content: "";
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
}

.hero::before {
    width: 420px;
    height: 420px;
    right: -180px;
    top: -210px;
    border: 1px solid rgba(33,134,83,.13);
    box-shadow: 0 0 0 35px rgba(33,134,83,.025),
                0 0 0 75px rgba(33,134,83,.02);
}

.hero::after {
    width: 180px;
    height: 180px;
    left: -100px;
    bottom: -100px;
    background: rgba(199,239,101,.15);
    filter: blur(8px);
}

.hero-content {
    display: grid;
    grid-template-columns: 1.03fr .97fr;
    align-items: center;
    gap: 65px;
}

.eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    margin-bottom: 20px;
    border: 1px solid #d5e9d5;
    border-radius: 30px;
    color: #176b43;
    background: rgba(255,255,255,.72);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}

.eyebrow::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #8ccf46;
    box-shadow: 0 0 0 4px rgba(140,207,70,.15);
}

.hero h1 {
    max-width: 560px;
    margin-bottom: 19px;
    color: var(--forest);
    font-size: clamp(34px, 4.2vw, 51px);
    font-weight: 850;
    line-height: 1.13;
    letter-spacing: -1.8px;
}

.hero-description {
    max-width: 490px;
    margin-bottom: 26px;
    color: #687a6e;
    font-size: 14px;
    line-height: 1.9;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
}

.hero-buttons .btn {
    padding: 12px 18px;
}

.hero-visual {
    position: relative;
    min-height: 335px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: 34px;
    border: 1px solid rgba(255,255,255,.8);
    border-radius: 24px;
    color: white;
    background:
        radial-gradient(circle at 85% 20%, rgba(199,239,101,.3), transparent 30%),
        linear-gradient(145deg, #174d35, #0d3025);
    box-shadow: 0 24px 55px rgba(18,61,43,.18);
}

.hero-visual::after {
    content: "";
    position: absolute;
    width: 240px;
    height: 240px;
    right: -85px;
    bottom: -105px;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 50%;
    box-shadow: 0 0 0 25px rgba(255,255,255,.035),
                0 0 0 55px rgba(255,255,255,.025);
}

.visual-topline {
    display: flex;
    align-items: center;
    gap: 9px;
    color: #d5e9d5;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.4px;
}

.visual-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 5px rgba(199,239,101,.12);
}

.visual-symbol {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 94px;
    height: 94px;
    margin: 35px 0 23px;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 27px;
    color: var(--lime);
    background: rgba(255,255,255,.09);
    font-size: 48px;
}

.visual-title {
    position: relative;
    z-index: 1;
    font-size: clamp(25px, 3vw, 36px);
    font-weight: 850;
    letter-spacing: -1px;
}

.hero-visual p {
    position: relative;
    z-index: 1;
    max-width: 340px;
    margin-top: 10px;
    color: #d5e4d8;
    font-size: 13px;
    line-height: 1.8;
}

.visual-bottom {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 30px;
    padding-top: 17px;
    border-top: 1px solid rgba(255,255,255,.17);
    color: #d5e4d8;
    font-size: 10px;
    font-weight: 700;
}

/* STATISTIK */
.stats-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 17px;
    margin-top: -28px;
}

.stat-card {
    position: relative;
    overflow: hidden;
    padding: 22px 23px;
    border: 1px solid rgba(220,232,220,.9);
    border-radius: 15px;
    background: white;
    box-shadow: 0 10px 28px rgba(18,61,43,.055);
    transition: transform .3s ease, box-shadow .3s ease;
}

.stat-card::before {
    content: "";
    position: absolute;
    width: 4px;
    left: 0;
    top: 18px;
    bottom: 18px;
    border-radius: 0 5px 5px 0;
    background: var(--green);
}

.stat-card:nth-child(2)::before {
    background: #8dbd43;
}

.stat-card:nth-child(3)::before {
    background: #e2aa48;
}

.stat-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
}

.stat-label {
    color: #78867d;
    font-size: 12px;
    font-weight: 600;
}

.stat-value {
    margin-top: 5px;
    color: var(--forest);
    font-size: 31px;
    font-weight: 850;
    letter-spacing: -1px;
    line-height: 1.4;
}

.stat-note {
    margin-top: 4px;
    color: #96a198;
    font-size: 11px;
}

/* SECTION */
.section {
    padding: 76px 0;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 27px;
}

.section-heading h2 {
    margin-bottom: 5px;
    color: var(--forest);
    font-size: 27px;
    font-weight: 850;
    letter-spacing: -.8px;
}

.section-heading p {
    color: var(--muted);
    font-size: 13px;
}

/* SEARCH */
.search-box {
    display: flex;
    gap: 9px;
    margin-bottom: 23px;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: white;
    box-shadow: 0 5px 18px rgba(18,61,43,.035);
    transition: border-color .25s, box-shadow .25s;
}

.search-box:focus-within {
    border-color: #8dbd9b;
    box-shadow: 0 0 0 4px rgba(33,134,83,.08);
}

.search-input {
    flex: 1;
    min-width: 0;
    padding: 11px 13px;
    border: 0;
    outline: 0;
    color: var(--ink);
    background: transparent;
    font-size: 13px;
}

.search-input:focus {
    border: 0;
    box-shadow: none;
}

/* TPS CARDS */
.tps-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 17px;
}

.tps-card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: white;
    box-shadow: 0 5px 18px rgba(18,61,43,.035);
    transition: transform .35s ease, box-shadow .35s ease,
                border-color .35s ease;
}

.tps-card:hover {
    transform: translateY(-7px);
    border-color: #c6dfc8;
    box-shadow: 0 17px 32px rgba(18,61,43,.11);
}

.tps-image {
    height: 155px;
    overflow: hidden;
    background: #e7efe7;
}

.tps-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .6s ease;
}

.tps-card:hover .tps-image img {
    transform: scale(1.07);
}

.tps-content {
    padding: 17px;
}

.status {
    display: inline-block;
    padding: 5px 10px;
    margin-bottom: 10px;
    border-radius: 30px;
    font-size: 10px;
    font-weight: 750;
}

.status-active {
    color: #237447;
    background: #e7f5e8;
}

.status-process {
    color: #95651a;
    background: #fff3d9;
}

.tps-content h3 {
    margin-bottom: 7px;
    color: var(--forest);
    font-size: 14px;
    font-weight: 750;
}

.tps-location {
    margin-bottom: 14px;
    color: #849087;
    font-size: 11px;
}

.tps-location i {
    margin-right: 4px;
    color: var(--green);
}

.tps-detail {
    display: block;
    padding: 9px;
    border: 1px solid #c8dfcd;
    border-radius: 8px;
    color: var(--forest-2);
    font-size: 11px;
    font-weight: 700;
    text-align: center;
    transition: all .25s ease;
}

.tps-detail:hover {
    color: white;
    border-color: var(--green);
    background: var(--green);
}

.empty-result {
    display: none;
    margin-top: 15px;
    padding: 25px;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--muted);
    background: white;
    text-align: center;
}

.data-note {
    margin-top: 17px;
    padding: 12px 15px;
    border-left: 3px solid #9acb65;
    border-radius: 5px;
    color: #778579;
    background: #edf5e9;
    font-size: 11px;
    line-height: 1.8;
}

/* REALTIME */
.live-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px;
    border: 1px solid #d5e9d5;
    border-radius: 30px;
    color: #176b43;
    background: white;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}

.live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0 rgba(34,197,94,.55);
    animation: livePulse 1.8s infinite;
}

.live-badge.is-offline { color: #95651a; border-color: #f0dca8; }
.live-badge.is-offline .live-dot { background: #e2aa48; animation: none; }

@keyframes livePulse {
    0%   { box-shadow: 0 0 0 0 rgba(34,197,94,.55); }
    70%  { box-shadow: 0 0 0 9px rgba(34,197,94,0); }
    100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
}

.stat-value.is-updated { animation: statFlash .9s ease; }

@keyframes statFlash {
    0%   { color: #22a35f; transform: scale(1.08); }
    100% { color: var(--forest); transform: scale(1); }
}

.tps-meta {
    margin: -6px 0 12px;
    color: #96a198;
    font-size: 10.5px;
}

.status-alert {
    color: #a33b2a;
    background: #fdeae6;
}

.load-more-wrap { margin-top: 20px; text-align: center; }

/* BANNER PENGADUAN */
.complaint-banner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
    padding: 38px 40px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 19px;
    color: white;
    background:
        radial-gradient(circle at 90% 10%, rgba(199,239,101,.23), transparent 28%),
        linear-gradient(120deg, #123d2b, #20774a);
    box-shadow: 0 15px 35px rgba(18,61,43,.16);
}

.complaint-banner::after {
    content: "";
    position: absolute;
    z-index: -1;
    width: 220px;
    height: 220px;
    right: 15%;
    bottom: -165px;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 50%;
    box-shadow: 0 0 0 25px rgba(255,255,255,.035),
                0 0 0 55px rgba(255,255,255,.025);
}

.complaint-banner h2 {
    margin-bottom: 8px;
    font-size: 24px;
    font-weight: 850;
    letter-spacing: -.5px;
}

.complaint-banner p {
    max-width: 650px;
    color: #d7e9dc;
    font-size: 12px;
    line-height: 1.8;
}

.complaint-banner .btn {
    position: relative;
    z-index: 1;
    padding: 12px 18px;
}

/* INFORMASI */
.information-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 17px;
}

.information-card {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: white;
    box-shadow: 0 5px 18px rgba(18,61,43,.035);
    transition: transform .3s ease, box-shadow .3s ease,
                border-color .3s ease;
}

.information-card:hover {
    transform: translateY(-6px);
    border-color: #c8dfca;
    box-shadow: var(--shadow);
}

.information-card .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 47px;
    height: 47px;
    margin-bottom: 16px;
    border-radius: 13px;
    color: #20794b;
    background: linear-gradient(145deg, #e8f6e8, #d9eddb);
    font-size: 22px;
    transition: transform .3s ease;
}

.information-card:hover .icon {
    transform: rotate(-7deg) scale(1.08);
}

.information-card h3 {
    margin-bottom: 8px;
    color: var(--forest);
    font-size: 14px;
    font-weight: 800;
}

.information-card p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
}

/* ANIMASI SCROLL */
.js-reveal .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .75s ease, transform .75s cubic-bezier(.2,.7,.2,1);
}

.js-reveal .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
}

.js-reveal .reveal-delay-1 {
    transition-delay: .12s;
}

.js-reveal .reveal-delay-2 {
    transition-delay: .23s;
}

.js-reveal .reveal-delay-3 {
    transition-delay: .34s;
}

@keyframes heroFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
}

.hero-image {
    animation: heroFloat 6s ease-in-out infinite;
}

/* RESPONSIVE */
@media (max-width: 950px) {
    .hero {
        padding: 60px 0 72px;
    }

    .hero-content {
        gap: 32px;
    }

    .hero h1 {
        font-size: clamp(31px, 4vw, 43px);
    }

    .hero-image {
        min-height: 270px;
    }

    .tps-grid {
        grid-template-columns: repeat(2, minmax(0,1fr));
    }
}

@media (max-width: 650px) {
    .container {
        width: 92%;
    }

    .navbar-content {
        min-height: auto;
        flex-wrap: wrap;
        gap: 10px;
        padding: 12px 0;
    }

    .brand h2 {
        font-size: 14px;
    }

    .nav-actions {
        gap: 6px;
    }

    .nav-actions .btn {
        padding: 8px 11px;
        font-size: 11px;
    }

    .nav-links {
        order: 3;
        width: 100%;
        justify-content: flex-start;
        gap: 23px;
        overflow-x: auto;
        padding: 5px 0;
    }

    .nav-links a {
        flex-shrink: 0;
        font-size: 12px;
    }

    .hero {
        padding: 43px 0 55px;
    }

    .hero-content {
        grid-template-columns: 1fr;
        gap: 26px;
    }

    .hero h1 {
        font-size: 34px;
        letter-spacing: -1px;
    }

    .hero-description {
        font-size: 13px;
    }

    .hero-image {
        min-height: 225px;
        border-radius: 15px;
    }

    .hero-buttons .btn {
        padding: 10px 12px;
        font-size: 11px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
        gap: 10px;
        margin-top: 17px;
    }

    .stat-card {
        padding: 15px 19px;
    }

    .stat-value {
        font-size: 25px;
    }

    .section {
        padding: 48px 0;
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column;
        gap: 10px;
    }

    .section-heading h2 {
        font-size: 23px;
    }

    .search-box {
        flex-direction: column;
    }

    .search-box .btn {
        width: 100%;
    }

    .tps-grid {
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 11px;
    }

    .tps-image {
        height: 120px;
    }

    .tps-content {
        padding: 12px;
    }

    .tps-content h3 {
        font-size: 12px;
    }

    .complaint-banner {
        align-items: flex-start;
        flex-direction: column;
        padding: 26px 23px;
    }

    .complaint-banner h2 {
        font-size: 21px;
    }

    .information-grid {
        grid-template-columns: 1fr;
    }

    .information-card {
        padding: 20px;
    }
}

@media (max-width: 380px) {
    .hero h1 {
        font-size: 30px;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .tps-grid {
        grid-template-columns: 1fr;
    }
}

/* AKSESIBILITAS: HORMATI PENGATURAN REDUKSI ANIMASI */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
    }

