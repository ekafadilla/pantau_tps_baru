/* ==================================================
   SI PANTAU TPS - REDESIGN STAGE 1
   Modern editorial / emerald and lime
================================================== */

:root {
    --forest: #123d2b;
    --forest-2: #204b38;
    --green: #176b49;
    --lime: #b8f500;
    --paper: #ffffff;
    --ink: #14291f;
    --muted: #78837c;
    --line: #e8ece8;
}

body {
    background: #fff;
    color: var(--ink);
    font-family: "Segoe UI", Arial, sans-serif;
}

.container {
    width: min(90%, 1320px);
}

/* TOPBAR */

.topbar {
    position: relative;
    z-index: 1001;
    background: var(--forest);
    color: #fff;
    font-size: 11px;
}

.topbar-inner {
    min-height: 37px;
    display: flex;
    align-items: center;
    gap: 28px;
}

.topbar-inner span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.topbar-inner i {
    color: var(--lime);
}

.topbar-highlight {
    margin-left: auto;
    padding: 0 20px;
    min-height: 37px;
    align-items: center;
    background: var(--lime);
    color: var(--forest);
    font-weight: 800;
}

/* NAVIGATION */

.navbar {
    position: sticky;
    top: 0;
    background: rgba(255,255,255,.97);
    border-bottom: 1px solid #edf0ed;
    box-shadow: 0 4px 18px rgba(18,61,43,.035);
}

.navbar-content {
    min-height: 82px;
}

.brand-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    color: var(--forest);
    background: var(--lime);
    box-shadow: none;
}

.brand h2 {
    font-family: Georgia, serif;
    font-size: 19px;
    letter-spacing: .2px;
    color: var(--forest);
}

.brand p {
    font-size: 10px;
    letter-spacing: .5px;
}

.nav-links {
    gap: 32px;
}

.nav-links a {
    color: #34483c;
    font-size: 12px;
    font-weight: 700;
}

.nav-links a::after {
    background: var(--lime);
    height: 3px;
}

.btn {
    border-radius: 5px;
    font-size: 12px;
    padding: 12px 19px;
}

.btn-primary {
    color: var(--forest);
    background: var(--lime);
    box-shadow: none;
}

.btn-primary:hover {
    color: #fff;
    background: var(--forest);
    box-shadow: none;
}

.btn-outline {
    border-color: #cbd5cd;
    color: var(--forest);
}

.btn-outline:hover {
    color: var(--forest);
    background: #f2f7ed;
}

/* HERO */

.hero {
    padding: 72px 0 75px;
    background: #f7f8f5;
    overflow: hidden;
}

.hero-content {
    grid-template-columns: 1fr 1fr;
    gap: 65px;
    min-height: 440px;
}

.hero-copy {
    position: relative;
    z-index: 2;
}

.eyebrow {
    border: 0;
    border-radius: 3px;
    padding: 0;
    margin-bottom: 23px;
    color: var(--green);
    background: transparent;
    font-size: 11px;
    letter-spacing: 1.2px;
}

.eyebrow::before {
    width: 9px;
    height: 9px;
    background: var(--lime);
    box-shadow: 4px 0 0 var(--forest);
}

.hero h1 {
    max-width: 610px;
    margin-bottom: 20px;
    color: #14291f;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: clamp(40px, 5vw, 65px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -2.5px;
}

.hero-description {
    max-width: 490px;
    color: #77817a;
    font-size: 14px;
    line-height: 1.9;
}

.hero-buttons {
    gap: 13px;
}

.hero-buttons .btn {
    min-height: 46px;
    padding: 12px 20px;
}

.hero-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 27px;
    color: #6d7c72;
    font-size: 11px;
    font-weight: 600;
}

.hero-note-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 4px rgba(184,245,0,.17);
}

/* PHOTO COLLAGE */

.hero-collage {
    position: relative;
    min-height: 405px;
    isolation: isolate;
}

.collage-main {
    position: absolute;
    top: 0;
    right: 0;
    width: 75%;
    height: 88%;
    overflow: hidden;
    border-radius: 8px 48px 8px 48px;
    background: #dce5dc;
}

.collage-main img,
.collage-secondary img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter .5s ease, transform .7s ease;
}

.hero-collage:hover img {
    filter: grayscale(25%);
}

.hero-collage:hover .collage-main img {
    transform: scale(1.04);
}

.collage-secondary {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 49%;
    height: 48%;
    overflow: hidden;
    border: 8px solid #f7f8f5;
    border-radius: 8px 35px 8px 35px;
    background: #dce5dc;
}

.collage-label {
    position: absolute;
    z-index: 3;
    left: 5%;
    top: 14%;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 13px 17px;
    border-radius: 6px;
    color: #fff;
    background: var(--forest);
    box-shadow: 0 12px 30px rgba(18,61,43,.2);
}

.collage-label-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--forest);
    background: var(--lime);
    font-size: 19px;
}

.collage-label strong,
.collage-label small {
    display: block;
}

.collage-label strong {
    font-size: 11px;
    letter-spacing: .5px;
}

.collage-label small {
    margin-top: 2px;
    color: #d5e3d9;
    font-size: 10px;
}

.collage-orbit {
    position: absolute;
    z-index: -1;
    right: -40px;
    bottom: 10px;
    width: 145px;
    height: 145px;
    border: 1px solid rgba(18,61,43,.16);
    border-radius: 50%;
    box-shadow: 0 0 0 18px rgba(18,61,43,.025),
                0 0 0 36px rgba(18,61,43,.02);
}

.collage-spark {
    position: absolute;
    z-index: 3;
    right: 4%;
    bottom: 5%;
    color: var(--lime);
    font-size: 55px;
    line-height: 1;
}

/* RUNNING TEXT */

.ticker-section {
    overflow: hidden;
    background: var(--forest);
    color: #fff;
}

.ticker-track {
    display: flex;
    width: max-content;
    animation: pantauTicker 32s linear infinite;
}

.ticker-section:hover .ticker-track {
    animation-play-state: paused;
}

.ticker-content {
    display: flex;
    align-items: center;
    gap: 34px;
    padding: 16px 18px;
    white-space: nowrap;
    font-size: 17px;
    font-weight: 700;
}

.ticker-content b {
    color: var(--lime);
    font-size: 23px;
}

@keyframes pantauTicker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
}

/* STATISTICS */

.stats-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin-top: 0;
    padding-top: 55px;
    padding-bottom: 55px;
}

.stat-card {
    position: relative;
    padding: 10px 28px;
    border: 0;
    border-right: 1px solid #dce3dd;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
}

.stat-card:last-child {
    border-right: 0;
}

.stat-card:hover {
    transform: none;
    box-shadow: none;
}

.stat-label {
    color: #77817a;
    font-size: 12px;
    font-weight: 600;
}

.stat-value {
    margin: 4px 0;
    color: var(--forest);
    font-size: clamp(31px, 3.5vw, 45px);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -1.5px;
}

.stat-note {
    color: #8a938c;
    font-size: 11px;
}

/* RESPONSIVE */

@media (max-width: 950px) {
    .hero-content {
        gap: 35px;
    }

    .hero h1 {
        font-size: clamp(36px, 5vw, 52px);
    }

    .hero-collage {
        min-height: 340px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        row-gap: 25px;
    }

    .stat-card:nth-child(2) {
        border-right: 0;
    }
}

@media (max-width: 650px) {
    .topbar-inner {
        min-height: 34px;
        justify-content: center;
        gap: 12px;
        font-size: 9px;
    }

    .topbar-inner span:nth-child(2) {
        display: none;
    }

    .topbar-highlight {
        display: none !important;
    }

    .navbar-content {
        min-height: 68px;
        flex-wrap: wrap;
        gap: 10px;
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .nav-links {
        order: 3;
        width: 100%;
        justify-content: center;
        gap: 24px;
        padding: 8px 0;
    }

    .nav-links a {
        font-size: 11px;
    }

    .brand h2 {
        font-size: 15px;
    }

    .brand-icon {
        width: 39px;
        height: 39px;
    }

    .nav-actions .btn {
        padding: 9px 12px;
        font-size: 10px;
    }

    .hero {
        padding: 48px 0 45px;
    }

    .hero-content {
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .hero h1 {
        font-size: clamp(37px, 10vw, 50px);
        letter-spacing: -1.7px;
    }

    .hero-description {
        font-size: 13px;
    }

    .hero-collage {
        min-height: 310px;
    }

    .collage-main {
        width: 82%;
    }

    .collage-secondary {
        width: 53%;
        height: 43%;
    }

    .ticker-content {
        gap: 20px;
        padding: 13px;
        font-size: 13px;
    }

    .stats-grid {
        padding-top: 35px;
        padding-bottom: 35px;
    }

    .stat-card {
        padding: 8px 15px;
    }

    .stat-value {
        font-size: 34px;
    }
}

@media (max-width: 380px) {
    .hero-buttons {
        flex-direction: column;
        align-items: stretch;
    }

    .hero-collage {
        min-height: 260px;
    }

    .stats-grid {
        grid-template-columns: 1fr 1fr;
    }

    .stat-card {
        border-right: 0;
        border-bottom: 1px solid #e5eae5;
    }
}

@media (prefers-reduced-motion: reduce) {
    .ticker-track {
        animation: none;
    }

    .hero-collage img {
        transition: none;
    }
}

